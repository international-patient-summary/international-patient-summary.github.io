{
	"name": "international-patient-summary.github.io",
	"version": "0.1.0",
	"description": "International Patient Summary website",
	"type": "module",
	"private": true,
	"license": "ISC",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"sync": "node bin/sync-content.mjs && node bin/vendor-lily.mjs",
		"sync:content": "node bin/sync-content.mjs",
		"sync:lily": "node bin/vendor-lily.mjs",
		"dev": "vite dev",
		"build": "node bin/sync-content.mjs --optional && vite build && node scripts/build-search-index.mjs build && node scripts/build-llms.mjs build && node scripts/build-sitemap.mjs build",
		"preview": "sirv build --port 4173 --dev",
		"check": "svelte-kit sync && svelte-check --threshold error",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lilydesignsystem/svelte-headless": "^0.13.1",
		"@lilydesignsystem/svelte-picker-bar": "^0.10.0",
		"@lilydesignsystem/themes": "^0.9.0",
		"github-slugger": "^2.0.0",
		"marked": "^18.2.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"sirv-cli": "^3.0.1",
		"svelte": "^5.58.0",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.8"
	}
}
